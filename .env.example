# Backend API URL
VITE_API_BASE_URL=http://localhost:5000/api/v1

# WebSocket URL (optional — derived from API URL if not set)
# VITE_SOCKET_URL=http://localhost:5000

# PayPal
VITE_PAYPAL_CLIENT_ID=your-paypal-client-id

# Google Pay (processed through PayPal).
# Requires "Google Pay" to be ENABLED on the PayPal app (Apps & Credentials →
# Features) — until then the Google Pay tile stays hidden.
# Leave unset/TEST while on PayPal sandbox; set to `production` only once the
# PayPal account is fully onboarded for live payments.
# VITE_GOOGLE_PAY_ENV=production
